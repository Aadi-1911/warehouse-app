# Local development values. See the PRODUCTION block at the bottom for what changes when this
# is deployed — the variable names are identical, only the values differ, and production values
# are set in the Vercel dashboard (Project → Settings → Environment Variables), never in a file
# committed to this repo.

# On Vercel this is supplied by the platform, not by you — server.js already reads
# `process.env.PORT || 3001`, which is exactly what a managed host expects. Leave it alone.
PORT=3001

# Postgres connection string (Neon/Supabase) — filled in once a database is provisioned.
DATABASE_URL=

# Separate Neon branch used ONLY by automated tests (server.js swaps DATABASE_URL to this when
# NODE_ENV=test) — keeps test fixtures from ever touching real hand-entered dev data.
TEST_DATABASE_URL=

# Signs and verifies login JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

NODE_ENV=development

# Frontend's deployed/dev URL, used by the cors middleware.
CORS_ORIGIN=http://localhost:5173


# ---------------------------------------------------------------------------------------------
# PRODUCTION (Vercel) — set these in the Vercel dashboard, NOT here. Never commit real values.
# ---------------------------------------------------------------------------------------------
#
# DATABASE_URL
#   The Neon PRODUCTION connection string — a different database (or at minimum a different Neon
#   branch) from the dev one, so a bad deploy can't write into hand-entered dev data. Use the
#   pooled connection string Neon offers for serverless callers: each Vercel invocation opens its
#   own client, and a direct non-pooled URL will exhaust Postgres connection slots under load.
#
# TEST_DATABASE_URL
#   Not needed in production — it is read only when NODE_ENV=test, which never holds on a
#   production deploy. Leave it unset there.
#
# JWT_SECRET
#   Generate a FRESH one for production with the same command above. Do not reuse the dev secret:
#   anything that leaks from a dev machine would otherwise mint valid production login tokens.
#   Rotating this invalidates every issued token, so every user is logged out on change — fine at
#   launch, worth knowing later.
#
# NODE_ENV=production
#   Load-bearing for security here, not just an optimisation flag: server.js's corsOrigin()
#   only honours the private-LAN-IP origin exception while NODE_ENV !== 'production'. Setting it
#   to production is what disables that dev-only allowance.
#
# CORS_ORIGIN
#   The deployed origin, e.g. https://<project>.vercel.app — known only AFTER the first deploy,
#   so expect to set this and redeploy once. NO trailing slash: corsOrigin() compares it by exact
#   string equality against the browser's Origin header, which never carries one, so a trailing
#   slash silently fails every cross-origin request.
#
#   Worth knowing: with the Vercel Services setup in /vercel.json, the frontend and backend are
#   served from ONE origin, so browser calls to /api/* are same-origin and the browser does not
#   apply CORS to them at all. CORS_ORIGIN is therefore not load-bearing for the app's own
#   traffic in that setup — set it correctly anyway, since it is what rejects anyone ELSE's site
#   from calling this API.
