PORT=3001

# Postgres connection string (Neon/Supabase) — filled in once a database is provisioned.
DATABASE_URL=

# Filled in once we pick session- or JWT-based auth (02_ARCHITECTURE.md §4.1).
JWT_SECRET=
SESSION_SECRET=

NODE_ENV=development

# Frontend's deployed/dev URL, used by the cors middleware.
CORS_ORIGIN=http://localhost:5173
